PORT=3001

# Générez une chaîne aléatoire longue (ex: openssl rand -hex 32).
# Si absent, un secret aléatoire est généré une fois et conservé dans la base.
JWT_SECRET=change-me-to-a-long-random-string

# Identifiants du compte admin créé automatiquement au premier démarrage
# (uniquement si la table users est vide). Si ADMIN_PASSWORD est absent,
# un mot de passe aléatoire est généré et affiché une seule fois en console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Origines autorisées à appeler l'API (séparées par des virgules). Vide = toutes.
# CORS_ORIGIN=http://localhost:5173,http://192.168.1.10:5173

# Taille maximale d'une requête (envois de synchronisation avec pièces jointes).
# BODY_LIMIT=50mb
